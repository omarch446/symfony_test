{% extends 'base.html.twig' %}

{% block title %}Batiment List{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Batiment List</h1>
    <a href="{{ path('app_batiment_create') }}">Create New Author</a>
    <div>
    
    {% for bat in batiments %}
        <div>
       
        <p><b>Username : </b> {{ bat.nom }} </p>
      <p><b>Enabled : </b> {{ bat.Disponible ? 'Yes' : 'No' }} </p>
      
        <p><b>Number Etage : </b> {{ bat.nbEtage }} </p>

        <a  href="{{ path('app_batiment_details', { id : bat.id })}}">Details</a>
        <a  href="{{ path('app_batiment_update', { id : bat.id })}}">Update</a>
        <a  href="{{ path('app_batiment_delete', { id : bat.id })}}">Delete</a>

        </div><hr>
    
    {% endfor %}
    </div>
    <div>
   
    
    </div>
</div>
{% endblock %}
