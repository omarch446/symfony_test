{% extends 'base.html.twig' %}

{% block title %}Batiment Details{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1> {{ title }} </h1>
    <div>
    <div>
    {% if batiment is not null %}

        <p><b>Username : </b> {{ batiment.nom }} </p>
        <p><b>Enabled : </b> {{ batiment.Disponible ? 'Yes' : 'No' }} </p>
       <p><b> Date de Constration : </b> {{ batiment.DateConstraction | date }} </p>
        <p><b>Number Etage : </b> {{ batiment.nbEtage }} </p>
        </div><hr>
    {% else %}
        <p>Batiment not found.</p>
    {% endif %}
    <a href="{{ path('app_batiment_list') }}" >Return to List</a>
    </div>
    
</div>
{% endblock %}
